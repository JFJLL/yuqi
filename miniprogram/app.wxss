page {
  min-height: 100%;
  background: #f3f6f8;
  color: #172332;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view, text, button, input, textarea, picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
}

.surface {
  background: #ffffff;
  border: 1rpx solid #dce5ea;
  border-radius: 12rpx;
}

.section {
  margin-top: 24rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 4rpx 16rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 650;
}

.section-link {
  color: #126b59;
  font-size: 26rpx;
}

.muted {
  color: #6b7b8d;
}

.caption {
  color: #778798;
  font-size: 24rpx;
  line-height: 1.5;
}

.status {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.status-red { background: #fdebec; color: #b4232e; }
.status-amber { background: #fff2d7; color: #8b5200; }
.status-green { background: #e7f6f0; color: #126b59; }
.status-blue { background: #e8f1fa; color: #175f9b; }
.status-gray { background: #eef2f4; color: #627080; }

.btn {
  min-height: 88rpx;
  padding: 0 28rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #cfdbe1;
  color: #263545;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 86rpx;
}

.btn-primary {
  background: #126b59;
  border-color: #126b59;
  color: #ffffff;
}

.btn-danger {
  background: #fff5f5;
  border-color: #efb8bc;
  color: #aa2933;
}

.btn-small {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  font-size: 25rpx;
  line-height: 62rpx;
}

.form-field {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #3d4b5b;
  font-size: 26rpx;
  font-weight: 600;
}

.input, .textarea, .picker-field {
  width: 100%;
  background: #f8fafb;
  border: 1rpx solid #d7e1e7;
  border-radius: 10rpx;
  color: #172332;
  font-size: 28rpx;
}

.input, .picker-field {
  height: 84rpx;
  padding: 0 22rpx;
  line-height: 82rpx;
}

.textarea {
  min-height: 220rpx;
  padding: 20rpx 22rpx;
  line-height: 1.65;
}

.empty {
  padding: 100rpx 32rpx;
  color: #758596;
  text-align: center;
}

.fixed-actions {
  position: sticky;
  bottom: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 20rpx 0 calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(rgba(243, 246, 248, 0), #f3f6f8 22%);
}
