.appeal-page { padding-bottom: calc(40rpx + env(safe-area-inset-bottom)); }
.source { padding: 24rpx; }
.source-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.source-title, .source-meta, .source-quote, .evidence-title, .evidence-copy .caption { display: block; }
.source-title { font-size: 30rpx; font-weight: 650; }
.source-meta { margin-top: 8rpx; color: #758596; font-size: 23rpx; }
.source-quote { margin-top: 18rpx; color: #425262; font-size: 25rpx; line-height: 1.6; }
.form-section { margin-top: 30rpx; }
.counter { display: block; margin-top: 8rpx; color: #8996a3; font-size: 22rpx; text-align: right; }
.evidence-row { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; padding: 24rpx; }
.evidence-copy { flex: 1; }
.evidence-title { margin-bottom: 6rpx; font-weight: 650; }
.attachment-list { display: flex; flex-wrap: wrap; gap: 16rpx; }
.attachment, .add-attachment { position: relative; width: 196rpx; height: 196rpx; border-radius: 10rpx; overflow: hidden; }
.attachment image { width: 100%; height: 100%; }
.remove { position: absolute; right: 0; bottom: 0; left: 0; padding: 8rpx; background: rgba(23,35,50,.72); color: #ffffff; font-size: 22rpx; text-align: center; }
.add-attachment { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; border: 1rpx dashed #b9c7cf; color: #6b7b8d; font-size: 23rpx; }
.add-mark { color: #126b59; font-size: 46rpx; line-height: 1; }
.submit-btn { margin-top: 40rpx; width: 100%; }
