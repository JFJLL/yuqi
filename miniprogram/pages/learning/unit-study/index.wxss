.container { padding: 30rpx; background: #f4f6f8; min-height: 100vh; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; border: 1rpx solid #e2e8f0; }
.title { font-size: 32rpx; font-weight: bold; color: #1a202c; display: block; margin-bottom: 10rpx; }
.duration { font-size: 24rpx; color: #718096; }
.content { font-size: 28rpx; color: #2d3748; line-height: 1.8; }
.btn-primary { background: #126b59; color: #fff; border-radius: 12rpx; font-size: 28rpx; height: 80rpx; line-height: 80rpx; }
