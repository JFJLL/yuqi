.login-page { display: flex; flex-direction: column; min-height: 100vh; padding: 0 44rpx calc(38rpx + env(safe-area-inset-bottom)); background: #f5f8f8; }
.safe-top { height: calc(88rpx + env(safe-area-inset-top)); }
.brand-block { padding: 74rpx 0 60rpx; }
.brand-logo { display: block; width: 360rpx; height: auto; }
.brand-name, .brand-sub, .login-title { display: block; }
.brand-name { margin-top: 34rpx; font-size: 42rpx; font-weight: 750; line-height: 1.3; }
.brand-sub { margin-top: 8rpx; color: #6d7d8e; font-size: 27rpx; }
.login-panel { padding: 32rpx; background: #ffffff; border: 1rpx solid #d9e3e7; border-radius: 12rpx; }
.login-title { margin-bottom: 26rpx; font-size: 31rpx; font-weight: 650; }
.identity-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 28rpx; padding: 19rpx 0; border-top: 1rpx solid #e8edef; color: #657587; font-size: 24rpx; }
.identity-value { color: #293948; text-align: right; }
.phone-login { width: 100%; height: 90rpx; margin-top: 30rpx; border-radius: 12rpx; background: #126b59; color: #ffffff; font-size: 29rpx; font-weight: 650; line-height: 90rpx; }
.agreement-row { display: flex; align-items: center; justify-content: center; margin-top: 24rpx; color: #788898; font-size: 22rpx; }
.agreement-check { display: flex; align-items: center; justify-content: center; width: 28rpx; height: 28rpx; margin-right: 10rpx; border: 1rpx solid #9dabb6; border-radius: 4rpx; color: #ffffff; font-size: 20rpx; }
.agreement-check.checked { background: #126b59; border-color: #126b59; }
.agreement-link { color: #126b59; }
.login-footer { margin-top: auto; color: #85929e; font-size: 21rpx; text-align: center; }
