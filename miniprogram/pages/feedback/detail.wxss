.detail-page { background: #ffffff; }
.detail-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 20rpx 4rpx 30rpx; border-bottom: 1rpx solid #e3eaee; }
.detail-title, .detail-meta, .block-label, .quote-text, .body-text, .context-title { display: block; }
.detail-title { font-size: 40rpx; font-weight: 700; line-height: 1.3; }
.detail-meta { margin-top: 10rpx; color: #758596; font-size: 23rpx; }
.quote-block { margin-top: 28rpx; padding: 26rpx; background: #fff7f7; border-left: 6rpx solid #bd3440; }
.block-label { margin-bottom: 14rpx; color: #526273; font-size: 24rpx; font-weight: 650; }
.quote-text { color: #2e3b49; font-size: 29rpx; line-height: 1.75; }
.detail-section { padding: 32rpx 4rpx; border-bottom: 1rpx solid #e7edef; }
.body-text { color: #364656; font-size: 28rpx; line-height: 1.8; }
.context-row { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-top: 28rpx; padding: 24rpx; }
.context-title { margin-bottom: 6rpx; font-weight: 650; }
.state-row { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; padding: 24rpx 4rpx; }
