[TEMPLATE]
# ---- 运行环境 ----
ENV=dev                          # dev | test | prod
APP_NAME=yuqi-api
API_PREFIX=/api/v1

# ---- 数据库 (async) ----
# PostgreSQL: postgresql+asyncpg://user:pass@127.0.0.1:5432/yuqi
DATABASE_URL=sqlite+aiosqlite:///./yuqi_dev.db
# 迁移时可用 MIGRATION_DATABASE_URL 覆盖 (测试/正式库隔离)

# ---- Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ENABLED=true

# ---- 认证 ----
# 生产必须更换为强随机值
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---- 安全 ----
SECURE_COOKIES=false             # 生产置 true (HTTPS)
CORS_ORIGINS=["http://localhost:8040","http://127.0.0.1:8040"]
TRUSTED_PROXIES=["127.0.0.1"]

# ---- 演示数据 ----
ALLOW_DEMO_SEED=false            # 生产禁止 true

# ---- 内部服务令牌 (OSS Scanner / ASR 网关) ----
# 生产必须更换为强随机值
INTERNAL_SERVICE_TOKEN=dev-internal-token

# ---- 对象存储 ----
STORAGE_PROVIDER=local           # local | aliyun_oss
LOCAL_STORAGE_DIR=./var/storage
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SIGNED_URL_TTL_SECONDS=600

# ---- ASR Provider ----
ASR_PROVIDER=mock                # mock | private
ASR_PRIVATE_BASE_URL=
ASR_PRIVATE_TOKEN=

# ---- LLM Provider (预留, 一期默认关闭) ----
LLM_ENABLED=false
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ---- SMS Provider ----
SMS_PROVIDER=mock
SMS_MOCK_FIXED_CODE=123456       # 仅测试环境; 生产必须为空
