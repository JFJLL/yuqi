# 统一环境变量模板 (复制为 .env.test / .env.production 后填写真实值)
# 禁止把真实密钥提交到 Git。

# ---------- PocketBase (yuqi-pb) ----------
YUQI_ENV=test                            # test | production (production 拒绝 demo seed / 固定验证码)
YUQI_SERVICE_TOKEN=<long-random-service-token>   # 内部服务 Token, 与网关/Worker/Scanner 一致
YUQI_SERVICE_TENANT_CODE=demo            # 内部服务默认租户 code
YUQI_UPLOAD_TOKEN_SECRET=<long-random-upload-secret>  # 短期上传令牌 HMAC 密钥
# 仅 dev/test: 固定验证码 (production 必须为空)
YUQI_DEV_FIXED_CODE=123456

# ---------- ASR Gateway (yuqi-asr-gateway) ----------
POCKETBASE_URL=http://127.0.0.1:7040
ASR_BASE_URL=http://127.0.0.1:18082      # frp 回环地址 (生产); 本地测试 http://127.0.0.1:18083
ASR_SERVICE_TOKEN=<asr-provider-token>
YUQI_ASR_GATEWAY_PORT=18084
# 测试环境 Mock 模式 (生产必须为 0/空)
YUQI_ASR_MOCK=1

# ---------- OSS Scanner (yuqi-oss-scanner) ----------
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=<bucket>
OSS_PREFIX=audio/
OSS_ACCESS_KEY_ID=<key-id>
OSS_ACCESS_KEY_SECRET=<key-secret>

# ---------- Business Worker (yuqi-business-worker) ----------
YUQI_PB_URL=http://127.0.0.1:7040
YUQI_WORKER_POLL_MS=3000
YUQI_WORKER_LOCK_MS=120000
