    "test:miniprogram": "node scripts/check-miniprogram.mjs",
    "test:integration": "node --test tests/integration/ticket-01-admin-shell.test.mjs tests/integration/ticket-02-wechat-auth.test.mjs tests/integration/ticket-03-regions-stores.test.mjs tests/integration/ticket-04-employees.test.mjs tests/integration/ticket-05-devices.test.mjs tests/integration/ticket-06-recordings.test.mjs tests/integration/ticket-07-inspection.test.mjs tests/integration/ticket-08-appeals.test.mjs tests/integration/ticket-09-recommendations.test.mjs tests/integration/ticket-10-training.test.mjs tests/integration/ticket-11-permissions.test.mjs tests/integration/ticket-12-reports.test.mjs tests/integration/ticket-13-settings.test.mjs tests/integration/ticket-14-audit.test.mjs tests/integration/ticket-15-mini-core.test.mjs tests/integration/ticket-16-mini-learning.test.mjs tests/integration/phase1-scenarios.test.mjs tests/integration/phase1-e2e-flow.test.mjs tests/integration/phase1-worker-lifecycle.test.mjs",
    "test:deploy": "node --test tests/deploy/deploy-scripts.test.mjs",
    "test:e2e": "node --test tests/e2e/phase1-subprocess-e2e.test.mjs",
