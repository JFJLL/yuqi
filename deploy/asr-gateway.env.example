# Yuqi 云端 ASR 网关配置示例。复制到服务器受保护的位置后填写，勿提交真实 .env 文件。
# 现有 frp TCP 代理的云端回环地址；本机 18083 -> 云端 18082。
# 示例：http://127.0.0.1:18082
ASR_BASE_URL=

# 与 ASR_SERVICE_TOKEN 保持一致的随机长 Token；不得写入前端、Nginx 或 Git。
ASR_SERVICE_TOKEN=

# Yuqi 服务内部地址。
POCKETBASE_URL=http://127.0.0.1:7040
YUQI_ASR_GATEWAY_HOST=127.0.0.1
YUQI_ASR_GATEWAY_PORT=18084

# 上传与轮询策略。Nginx 的 client_max_body_size 也必须不小于此上限。
YUQI_ASR_MAX_UPLOAD_MB=200
YUQI_ASR_POLL_INTERVAL_MS=5000
YUQI_ASR_MAX_POLL_JOBS=100
YUQI_ASR_REQUEST_TIMEOUT_MS=60000

# ---- OSS 自动采集（yuqi-oss-scanner 使用）----
# 阿里云 OSS Endpoint（不带 Bucket 前缀），例如：
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com

# Bucket 与录音前缀。厂商平台「推送路径」需与此一致，例如 audio/
OSS_BUCKET=
OSS_PREFIX=audio/

# 访问 OSS 的凭证。建议使用仅该 Bucket 只读权限的 RAM 子账号；如用主账号 AK，务必只保存在本文件。
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=

# 扫描与提交策略。
SCAN_INTERVAL_MS=300000
OSS_MAX_LIST_KEYS=1000
SCANNER_MAX_SUBMITS_PER_CYCLE=20
SCANNER_MAX_SUBMIT_RETRIES=2
SCANNER_MAX_ASR_ATTEMPTS=3
SCANNER_RETRY_BACKOFF_BASE_MS=600000
SCANNER_REQUEST_TIMEOUT_MS=120000
SCANNER_STALE_SUBMITTING_MS=1800000
