        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In"
          },
          "user": {
            "$ref": "#/components/schemas/UserOut"
          },
          "tenant": {
            "$ref": "#/components/schemas/TenantOut"
          },
          "permissions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Permissions"
          },
          "data_scope_types": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Data Scope Types"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in",
          "user",
          "tenant",
          "permissions",
          "data_scope_types"
